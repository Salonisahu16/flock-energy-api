{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy API Client",
    "description": "API for retrieving meter information, energy readings, and geographic data.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Home",
        "operationId": "home__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/meters": {
      "get": {
        "summary": "Search Meters",
        "operationId": "search_meters_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Meter search query",
              "default": "",
              "title": "Q"
            },
            "description": "Meter search query"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterSearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/energy": {
      "get": {
        "summary": "Get Meter Energy",
        "operationId": "get_meter_energy_meters__meter_id__energy_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/meters/{meter_id}/geo": {
      "get": {
        "summary": "Get Meter Geo",
        "operationId": "get_meter_geo_meters__meter_id__geo_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "kwh": {
            "type": "number",
            "title": "Kwh"
          },
          "kvah": {
            "type": "number",
            "title": "Kvah"
          },
          "voltR": {
            "type": "number",
            "title": "Voltr"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "voltR"
        ],
        "title": "EnergyReading"
      },
      "EnergyResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "EnergyResponse"
      },
      "GeoData": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "GeoData"
      },
      "GeoResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GeoData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "GeoResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meter": {
        "properties": {
          "meterId": {
            "type": "string",
            "title": "Meterid"
          },
          "serialNo": {
            "type": "string",
            "title": "Serialno"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phaseType": {
            "type": "string",
            "title": "Phasetype"
          },
          "installStatus": {
            "type": "string",
            "title": "Installstatus"
          },
          "dtCode": {
            "type": "string",
            "title": "Dtcode"
          }
        },
        "type": "object",
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "dtCode"
        ],
        "title": "Meter"
      },
      "MeterSearchResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Meter"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MeterSearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}